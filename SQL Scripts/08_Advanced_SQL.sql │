-- 7. CALCULATE THE NUMBER OF TITLES ADDED TO NETFLIX EACH YEAR AND THE PERCENTAGE GROWTH COMPARED WITH THE PREVIOUS YEAR

WITH YEARLY_COUNT AS 
( 
SELECT 
YEAR (DATE_ADDED ) AS YEAR ,
COUNT (*) AS TITLE_COUNT 
FROM NETFLIX 
WHERE DATE_ADDED IS NOT NULL 
GROUP BY YEAR(DATE_ADDED) 
) 
SELECT 
YEAR , 
TITLE_COUNT ,
LAG (TITLE_COUNT ) OVER (ORDER BY YEAR ) AS PREVIOUS_YEAR_COUNT, 
ROUND (
(TITLE_COUNT - LAG (TITLE_COUNT) OVER (ORDER BY YEAR )) * 100.0 
/ LAG (TITLE_COUNT ) OVER (ORDER BY YEAR ) ,
2
) AS GROWTH_PERCENTAGE 
FROM YEARLY_COUNT 
ORDER BY YEAR


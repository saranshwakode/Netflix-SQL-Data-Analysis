-- 8 . FIND THE TOP 3 DIRECTORS FROM EACH COUNTRY BASED ON THE NUMBER OF NETFLIX TITLES THEY HAVE DIRECTED 
WITH DIRECTOR_COUNT AS
(
SELECT
TRIM(C.VALUE) AS COUNTRY,
DIRECTOR,
COUNT(*) AS TITLE_COUNT
FROM NETFLIX
CROSS APPLY STRING_SPLIT(COUNTRY, ',') C
WHERE DIRECTOR IS NOT NULL
AND COUNTRY IS NOT NULL
GROUP BY TRIM(C.VALUE), DIRECTOR
),
RANKED_DIRECTORS AS
(
SELECT
COUNTRY,
DIRECTOR,
TITLE_COUNT,
ROW_NUMBER() OVER
(
PARTITION BY COUNTRY
ORDER BY TITLE_COUNT DESC
 ) AS RN
FROM DIRECTOR_COUNT
)
SELECT
COUNTRY,
DIRECTOR,
TITLE_COUNT
FROM RANKED_DIRECTORS
WHERE RN <= 3
ORDER BY COUNTRY, TITLE_COUNT DESC;
---------------------------------------- BUSINESS INSIGHT --------------------------------------------------------------------

--TOP DIRECTORS HAVE THE BEST PERFORMACE IN NETFLIX CATALOG AND HAVE A HIGHER RATE OF THE INFLUENCING PROPERTY TO MAKE PROFIT FOR NETFLIX 


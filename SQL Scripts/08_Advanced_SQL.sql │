-- 5 . IDENTIDY ACTORS WHO HAVE APPEARED IN THE HIGHEST NUMBER OF NETFLIX TITLES 
 SELECT TOP 10 
 CAST_MEMBERS ,
 COUNT(*) AS TOTAL_TITLES
 FROM NETFLIX 
 WHERE CAST_MEMBERS IS NOT NULL
 GROUP BY CAST_MEMBERS 
 ORDER BY TOTAL_TITLES DESC


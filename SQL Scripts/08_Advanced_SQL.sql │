 --3 FIND THE LONGEST RUNNING TV SHOWS BASED ON THE NUMBERS OF SEASONS
 
SELECT TOP 20
TITLE,
TYPE,
DURATION 
FROM NETFLIX 
WHERE type = 'TV SHOW '
ORDER BY  DURATION DESC

--BUSINESS INSIGHT 
--1 . LONG TV SHOWS HAVE THE STRONG ENGAGEMENT OF THE AUDIENCE 
--2. SHOWS WITH MORE SEASONS ARE MORE CAPABLE FOR THE RETENTION OF CUSTOMERS 


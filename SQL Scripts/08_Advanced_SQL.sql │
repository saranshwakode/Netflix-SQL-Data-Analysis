 ---1. FIND THE TOP 5 DIRECTORS IN EACH COUNTRY BASED ON THE NUMBER OF TITLES RELEASED ?
 SELECT TOP 5 
 DIRECTOR ,
 COUNTRY ,
 COUNT(*) AS TOTAL_TITLES 
 FROM NETFLIX 
 WHERE DIRECTOR IS NOT NULL 
 AND COUNTRY IS NOT NULL
 GROUP BY DIRECTOR , COUNTRY 
 ORDER BY TOTAL_TITLES DESC 
 
 -- BUSINESS INSIGHT --
 -- 1. MARCUS RABOY FROM US HAVE THE HIGHEST NUMBER OF THE TITLES RELEASED 
 --====================================================================================

 --2.FOR EVERY GENRE CALCULATE ITS PERCENTAGE CONTRIBUTION TO THE ENTIRE NETFLIX CATALOG 

SELECT 
LISTED_IN AS GENRE ,
COUNT(*) AS TOTAL_TITLES ,
ROUND(
COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (),2
 ) AS TOTAL_PERCENTAGE 
 FROM NETFLIX 
 GROUP BY LISTED_IN 
 ORDER BY TOTAL_PERCENTAGE DESC 
 
 --BUSINESS INSIGHT---
 -- 1. SOME GENRE CONTRIBUTE A MUCH LARGER SHARE OF NETFLIX'S CATALOG THAN OTHERS 
 --2 .POPULAR GENRES DOMINATE THE CONTENT LIBRARY REFLECTING VIEWER DEMAND AND NETFLIX CONTENT STRATEGY 


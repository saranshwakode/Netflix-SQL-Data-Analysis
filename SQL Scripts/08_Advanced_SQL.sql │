--6. WHAT PERCENTAGE OF NETFLIX TOTAL CATALOG COMES FROM ITS TOTAL 5 COUNTRIES , AND DOES NETFLIX HAVE A HIGH DEPENDENCE ON A FEW MARKETS ?
WITH COUNTRY_COUNT AS 
(
SELECT 
TRIM (VALUE) AS COUNTRY ,
COUNT (*) AS TITLES_COUNT 
FROM NETFLIX 
CROSS APPLY STRING_SPLIT (COUNTRY , ',') 
WHERE COUNTRY IS NOT NULL 
GROUP BY TRIM (VALUE) 
) ,RANKED_COUNTRIES AS ( 
SELECT 
COUNTRY ,
TITLES_COUNT ,
RANK () OVER (ORDER BY TITLES_COUNT DESC) AS RNK 
FROM COUNTRY_COUNT
) 
SELECT 
SUM (TITLES_COUNT ) * 100.0 / (SELECT COUNT (*) FROM NETFLIX ) AS TOP_5_PERCENTAGE 
FROM RANKED_COUNTRIES 
WHERE RNK < = 5 ;


--4 . FIND THE OLDEST MOVIE AVAILABLE ON NETFLIX 

SELECT TOP 1 
TITLE ,
TYPE ,
RELEASE_YEAR 
FROM NETFLIX 
WHERE TYPE = 'MOVIE'
ORDER BY RELEASE_YEAR ASC

-- BUSINESS INSIGHT 
--1 THE PRELUDE TO WAR IS THE OLDEST MOVIE AVAILABLE ON NETFLIX WHICH WAS RELEASE IN YEAR 1942

